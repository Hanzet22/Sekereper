{
  "name": "hanzet-scraper",
  "version": "3.7.0",
  "private": true,
  "description": "Modular HTTP(S) crawler and scraper with bounded jobs, exports, and SSRF protections",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build:ui:css && node --watch server.js",
    "test": "node --test",
    "build:ui:css": "npx @tailwindcss/cli -i ./ui/css/tailwind.input.css -o ./ui/css/tailwind.css --minify",
    "watch:ui:css": "npx @tailwindcss/cli -i ./ui/css/tailwind.input.css -o ./ui/css/tailwind.css --watch"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "playwright-core": "^1.55.0"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}