# Copy to .env and set values appropriate for your deployment.
HOST=127.0.0.1
PORT=3131
NODE_ENV=development
# Required to enable /admin endpoints. Use a long random secret.
# Leave unset to keep admin endpoints disabled.
ADMIN_TOKEN=
# Optional exact origins, comma-separated. Empty means no browser CORS origins are allowed.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REQUEST_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=3000000
MAX_BATCH_SIZE=5
MAX_CONCURRENT_JOBS=3
MAX_REDIRECTS=3
# Optional: use distro-provided Chromium on Alpine/musl systems.
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
